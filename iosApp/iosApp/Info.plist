<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.himanshu.liftly.sync</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>LiftlySignInWithApple</key>
	<string>$(SIGN_IN_WITH_APPLE)</string>
	<key>LiftlyGoogleClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plain HTTP only to the local dev server (localhost); everything else needs HTTPS. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.himanshu.liftly</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>liftly</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>liftly://start-next-workout</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Start next workout</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypePlay</string>
		</dict>
	</array>
</dict>
</plist>
