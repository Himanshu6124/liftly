# /etc/liftly/liftly.env (root:liftly, mode 0640). Generated on the server by deploy/README.md step 3.
HOST=127.0.0.1
PORT=8090
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/liftly
DATABASE_USER=liftly
DATABASE_PASSWORD=<random, generated on the server>
DATABASE_POOL_SIZE=4
JWT_SECRET=<random, generated on the server: openssl rand -base64 48>
APPLE_AUDIENCES=com.himanshu.liftly
# Google OAuth client ids: Web (Android) and iOS, comma-separated. Empty = Google sign-in off.
GOOGLE_AUDIENCES=
